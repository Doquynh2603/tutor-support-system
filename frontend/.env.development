# Environment Variables for Development (No Authentication)
VITE_API_URL=http://localhost:5000
VITE_APP_NAME=Tutor Support System
VITE_NODE_ENV=development

# Development flags
VITE_ENABLE_AUTH=false
VITE_MOCK_USER_ID=1
VITE_DEBUG_API=true

# Database connection (for backend reference)
DB_SERVER=localhost
DB_DATABASE=TutorSupportSystem
DB_INTEGRATED_SECURITY=true